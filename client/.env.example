# Firebase Configuration
# Get these values from your Firebase Console -> Project Settings -> Your Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase App Check (reCAPTCHA Enterprise site key)
# Register the site key at Firebase Console -> App Check -> your web app,
# then paste the reCAPTCHA Enterprise site key here. Without this, App Check
# does not initialize and callables with `enforceAppCheck: true` will reject
# every request.
VITE_APPCHECK_SITE_KEY=your_recaptcha_enterprise_site_key

# EmailJS Configuration
# Get these values from your EmailJS dashboard
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PROVISION_TEMPLATE_ID=your_provision_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
